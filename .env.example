# Variables de docker-compose.yml. Copiar a .env (no va a git) y completar los valores.

# Servicio de Usuarios (wa-users-service) y su PostgreSQL
USERS_DB_NAME=
USERS_DB_USER=
USERS_DB_PASSWORD=
# Puerto del host donde se publica el servicio (dentro del contenedor escucha en 8080). Por defecto 8080.
USERS_HTTP_PORT=
