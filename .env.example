# Variables de entorno para el stack E2E local
# Copiar a .env. Los valores de ejemplo son ficticios y solo para uso local.
# No usar estos valores en producción ni guardar credenciales reales en el repo.

# Base de datos compartida
DB_USERNAME=app
DB_PASSWORD=app
USERS_DB_NAME=wa_users
CREDENTIALS_DB_NAME=wa_credentials
CHANNEL_DB_NAME=wa_channel
ACCOUNTS_DB_NAME=wa_accounts
CARDS_DB_NAME=wa_cards
INSURANCE_DB_NAME=wa_insurance
KB_DB_NAME=wa_knowledge

# Orquestador
ORCHESTRATOR_DB_NAME=wa_orchestrator
ORCHESTRATOR_DB_USER=orchestrator
ORCHESTRATOR_DB_PASSWORD=orchestrator

# JWT
CREDENTIAL_JWT_SECRET=cambiar-por-clave-de-al-menos-32-bytes-1234567890
# Generar dos secretos locales distintos; H2 y H3 comparten el primero.
CREDENTIAL_H3_SERVICE_TOKEN=
CREDENTIAL_BANK_SERVICE_TOKEN=

# Puertos host
USERS_HOST_PORT=8080
CHANNEL_HOST_PORT=8081
CREDENTIALS_HOST_PORT=8082
ACCOUNTS_HOST_PORT=8084
INSURANCE_HOST_PORT=8085
CARDS_HOST_PORT=8086
EVENT_PLATFORM_PORT=8092
GATEWAY_PORT=8090
ORCHESTRATOR_PORT=8091
MCP_HOST_PORT=8101
RAG_HOST_PORT=8102
AGENT_HOST_PORT=8103
KB_DB_HOST_PORT=5438
AGENT_REDIS_HOST_PORT=6379
AGENT_MEMORY_HOST_PORT=8000

# Twilio (simulado/local): no son credenciales reales de Twilio. El gateway
# valida la firma de todo webhook con TwilioSignatureValidator y no arranca si
# estos valores estan vacios, aunque sea para simular en local. Dejamos un
# valor de ejemplo no sensible para que el smoke E2E pueda firmar el webhook
# simulado con el mismo TWILIO_AUTH_TOKEN; cambiar si se usa una cuenta real.
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=local-dev-auth-token-cambiar-en-prod
TWILIO_WEBHOOK_PUBLIC_URL=http://localhost:8090/webhook/twilio
TWILIO_STATUS_CALLBACK_PUBLIC_URL=https://localhost:8090/webhooks/twilio/status
TWILIO_WHATSAPP_FROM=whatsapp:+15005550006

# IA
# GOOGLE_API_KEY es una credencial real (Gemini) que no se puede simular: sin
# ella, H8 (RAG) devuelve 503 en /retrieval y H9 no puede generar respuesta.
# Completar con una clave propia para habilitar el tramo final del E2E.
GOOGLE_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768
RAG_TOP_K=5
AGENT_MODEL=gemini-2.5-flash
AGENT_MEMORY_KEY_SECRET=cambiar-por-clave-de-al-menos-32-bytes-abcdefgh
# AGENT_SERVICE_TOKEN (H9) y H9_SERVICE_TOKEN (H0.2) son el mismo secreto
# compartido visto desde cada lado: deben tener idéntico valor.
AGENT_SERVICE_TOKEN=cambiar-token-compartido-h02-h9
AGENT_SESSION_TTL_MINUTES=30
H9_TIMEOUT_MS=5000
H9_SERVICE_TOKEN=cambiar-token-compartido-h02-h9
