# Variables de entorno para el stack E2E local
# Copiar a .env y completar secretos reales si aplica

# Base de datos compartida
DB_USERNAME=app
DB_PASSWORD=app
USERS_DB_NAME=wa_users
CREDENTIALS_DB_NAME=wa_credentials
CHANNEL_DB_NAME=wa_channel
ACCOUNTS_DB_NAME=wa_accounts
CARDS_DB_NAME=wa_cards
INSURANCE_DB_NAME=wa_insurance
KB_DB_NAME=wa_knowledge

# Orquestador
ORCHESTRATOR_DB_NAME=wa_orchestrator
ORCHESTRATOR_DB_USER=orchestrator
ORCHESTRATOR_DB_PASSWORD=orchestrator

# JWT
CREDENTIAL_JWT_SECRET=cambiar-por-clave-de-al-menos-32-bytes-1234567890

# Puertos host
USERS_HOST_PORT=8080
CHANNEL_HOST_PORT=8081
