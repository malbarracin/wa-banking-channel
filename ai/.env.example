# Copiar a ai/.env (fuera de git). Solo nombres y valores de ejemplo — sin secretos reales.

# Postgres compartido (H1–H6 + kb-postgres)
DB_USERNAME=app
DB_PASSWORD=cambiar

USERS_DB_NAME=wa_users
CREDENTIALS_DB_NAME=wa_credentials
CHANNEL_DB_NAME=wa_channel
ACCOUNTS_DB_NAME=wa_accounts
CARDS_DB_NAME=wa_cards
INSURANCE_DB_NAME=wa_insurance
KB_DB_NAME=wa_knowledge

# H2 JWT (mín. 32 bytes UTF-8)
CREDENTIAL_JWT_SECRET=cambiar-por-clave-de-al-menos-32-bytes

# Puertos host
MCP_HOST_PORT=8101
RAG_HOST_PORT=8102
USERS_HOST_PORT=8080
CHANNEL_HOST_PORT=8081
CREDENTIALS_HOST_PORT=8082
ACCOUNTS_HOST_PORT=8084
INSURANCE_HOST_PORT=8085
CARDS_HOST_PORT=8086
KB_DB_HOST_PORT=5438
AGENT_REDIS_HOST_PORT=6379
AGENT_MEMORY_HOST_PORT=8000

# Agent Memory Server (H9; vacío en local si no se usa embeddings del memory server)
OPENAI_API_KEY=

# Timeouts / flags H7 (también en wa-mcp-layer/.env.example)
MCP_CLIENTS_CONNECT_TIMEOUT_MS=2000
MCP_CLIENTS_READ_TIMEOUT_MS=5000
MCP_CAPABILITY_ACCESO_REVOCAR_CREDENCIALES_MASIVO_ENABLED=false

# H8 — Base de conocimiento RAG (también en wa-knowledge-rag/.env.example)
GOOGLE_API_KEY=
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768
RAG_TOP_K=5
RAG_CONFIDENCE_HIGH_MIN=
RAG_CONFIDENCE_MEDIUM_MIN=
LOG_LEVEL=INFO

# H9 — completar ambos secretos antes de iniciar el agente (clave de memoria: mínimo 32 caracteres).
AGENT_HOST_PORT=8103
AGENT_MODEL=gemini-2.5-flash
AGENT_MEMORY_KEY_SECRET=
AGENT_SERVICE_TOKEN=
AGENT_SESSION_TTL_MINUTES=30
