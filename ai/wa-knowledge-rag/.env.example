# Copiá a .env (fuera de git) y completá los valores. Nunca commits secretos.
# Variables de Postgres del compose: ver .env.compose.example (no las mezcles acá:
# Settings solo acepta KB_* y GOOGLE_API_KEY).

KB_PORT=8102
# CLI/tests en el host (puerto publicado del compose). Dentro del compose la URL la fija el servicio.
KB_DATABASE_URL=postgresql://kb:@localhost:5432/wa_knowledge
GOOGLE_API_KEY=
KB_EMBEDDING_MODEL=gemini-embedding-001
KB_EMBEDDING_DIMENSIONS=768
KB_ENVIRONMENT=dev
# JSON: [{"id":"wa-conversation-agent","token_sha256":"<hex>","allow_internal":true}]
KB_CONSUMERS=
KB_CONFIDENCE_THRESHOLD=0.70
KB_MIN_RELEVANCE=0.45
KB_AMBIGUITY_MARGIN=0.05
KB_LEXICAL_BONUS=0.05
KB_APPROVAL_POLICY_PATH=config/approval-policy.yaml
# Intervalo del servicio wa-knowledge-rag-sync (`kb sync --loop`): Ns|Nm|Nh
KB_SYNC_INTERVAL=24h
KB_MAX_CHARS_WHATSAPP=1000
KB_EMBEDDING_TIMEOUT_S=5
