# El webhook requiere token y URL pública exacta por entorno.
SERVER_PORT=8090
# Cuenta reservada para outbound; Kafka para el adaptador de publicación.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_PUBLIC_URL=
TWILIO_STATUS_CALLBACK_PUBLIC_URL=
TWILIO_WHATSAPP_FROM=
OUTBOUND_DB_URL=jdbc:h2:file:./data/outbound;DB_CLOSE_ON_EXIT=FALSE;WRITE_DELAY=0
OUTBOUND_DB_USER=sa
OUTBOUND_DB_PASSWORD=
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
