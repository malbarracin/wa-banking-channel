# Copiar a .env (fuera de git) o exportar al proceso. Spring no carga .env solo.
# Host JAR + compose (listener PLAINTEXT_HOST):
SERVER_PORT=8090
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# App en red Docker (profile app): KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Credenciales Twilio — solo por entorno; nunca valores reales en el repo.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# URLs públicas exactas usadas por RequestValidator (esquema, host y path firmados).
# Webhooks reales en local: levantá un túnel (ngrok u similar) hacia :8090 y usá
# la URL HTTPS pública, p.ej. https://<subdominio>.ngrok-free.app/webhook/twilio
# y https://<subdominio>.ngrok-free.app/webhooks/twilio/status. Configurá las
# mismas URLs en la consola de Twilio.
TWILIO_WEBHOOK_PUBLIC_URL=
TWILIO_STATUS_CALLBACK_PUBLIC_URL=

# Outbound (default true). false desactiva listener/envío y credenciales extra.
GATEWAY_OUTBOUND_ENABLED=true
OUTBOUND_DB_URL=jdbc:h2:file:./data/outbound;DB_CLOSE_ON_EXIT=FALSE;WRITE_DELAY=0
# En contenedor (compose profile app): jdbc:h2:file:/app/data/outbound;DB_CLOSE_ON_EXIT=FALSE;WRITE_DELAY=0
OUTBOUND_DB_USER=sa
OUTBOUND_DB_PASSWORD=

WEBHOOK_ANTI_REPLAY_WINDOW_SECONDS=300
WEBHOOK_ANTI_REPLAY_CAPACITY=10000

# Fuera de local (no poner valores reales en el repo): TLS/SASL vía
# SPRING_KAFKA_PROPERTIES_SECURITY_PROTOCOL, SPRING_KAFKA_PROPERTIES_SASL_MECHANISM,
# SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG
