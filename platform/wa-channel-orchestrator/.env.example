# Copiar a .env (fuera de git) o exportar al proceso. Spring no carga .env solo.
# Host JAR + compose (listener PLAINTEXT_HOST / Postgres en host):
SERVER_PORT=8091
SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5436/wa_orchestrator
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
# Puerto host → Postgres del compose (5436 por defecto para no chocar con Postgres local/H1–H6).
ORCHESTRATOR_DB_HOST_PORT=5436
POSTGRES_DB=wa_orchestrator
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# App en red Docker (profile app): KAFKA_BOOTSTRAP_SERVERS=kafka:29092
# y SPRING_DATASOURCE_URL=jdbc:postgresql://orchestrator-db:5432/wa_orchestrator

# Sagas: ISO-8601 duration and timeout scan interval in milliseconds
ORCHESTRATOR_SAGA_STEP_TIMEOUT=PT24H
SAGA_TIMEOUT_CHECK_INTERVAL_MS=60000

# H9 — token solo por entorno; nunca valores reales en el repo.
# Host JAR: http://localhost:8099
# Contenedor (compose profile app): http://host.docker.internal:8099
# Si H9 solo es alcanzable por túnel, usá la URL HTTPS pública del túnel.
H9_BASE_URL=http://localhost:8099
H9_SERVICE_TOKEN=
H9_CONNECT_TIMEOUT_MS=1000
H9_TIMEOUT_MS=5000
H9_MAX_RETRIES=2
H9_BACKOFF_MS=200

OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_MAX_ATTEMPTS=3
OUTBOX_BACKOFF_MS=1000
OUTBOX_SEND_TIMEOUT_MS=10000

# Fuera de local (no poner valores reales en el repo): TLS/SASL vía
# SPRING_KAFKA_PROPERTIES_SECURITY_PROTOCOL, SPRING_KAFKA_PROPERTIES_SASL_MECHANISM,
# SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG
