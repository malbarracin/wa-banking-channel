SERVER_PORT=8091
SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/wa_orchestrator
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# Sagas: ISO-8601 duration and timeout scan interval in milliseconds
ORCHESTRATOR_SAGA_STEP_TIMEOUT=PT24H
SAGA_TIMEOUT_CHECK_INTERVAL_MS=60000
H9_BASE_URL=http://localhost:8099
H9_SERVICE_TOKEN=
H9_CONNECT_TIMEOUT_MS=1000
H9_TIMEOUT_MS=5000
H9_MAX_RETRIES=2
H9_BACKOFF_MS=200
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_MAX_ATTEMPTS=3
OUTBOX_BACKOFF_MS=1000
OUTBOX_SEND_TIMEOUT_MS=10000
