# Copiar como .env (ignorado por git) y ajustar. Solo nombres de variables:
# nunca se versiona una credencial.

# Aplicación
SERVER_PORT=8092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_PROFILES_ACTIVE=local

# Stack de docker compose
# KAFKA_HOST_PORT: puerto del broker en la PC (el listener interno es kafka:19092)
# APP_HOST_PORT: puerto de la plataforma en la PC cuando corre en contenedor
# WA_EVENT_PLATFORM_TAG: etiqueta de la imagen que levanta el compose
KAFKA_HOST_PORT=9092
APP_HOST_PORT=8092
WA_EVENT_PLATFORM_TAG=local

# Ambientes compartidos: Kafka con TLS y SASL/SCRAM. Los valores los inyecta el
# ambiente (nunca el repositorio) y Spring los toma con estos nombres.
# SPRING_KAFKA_SECURITY_PROTOCOL=SASL_SSL
# SPRING_KAFKA_PROPERTIES_SASL_MECHANISM=SCRAM-SHA-512
# SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG=
