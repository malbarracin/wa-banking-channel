# Copiar a .env (fuera de git) o exportar al proceso. Spring no carga .env solo.
# Host JAR + compose (listener PLAINTEXT_HOST):
SERVER_PORT=8092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# App en red Docker (profile app): KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_ADMIN_AUTO_CREATE=true
KAFKA_ADMIN_FAIL_FAST=true
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICAS=1
KAFKA_RECEIVED_RETENTION=7d
KAFKA_READY_TO_SEND_RETENTION=7d
KAFKA_STATUS_RETENTION=30d
KAFKA_DLQ_RETENTION=90d
KAFKA_PRODUCER_RETRIES=10
KAFKA_CONSUMER_GROUP_ID=wa-event-platform
KAFKA_CONSUMER_MAX_RETRIES=3
KAFKA_CONSUMER_RETRY_INITIAL_INTERVAL=1000
KAFKA_CONSUMER_RETRY_MAX_INTERVAL=10000
# Fuera de local (no poner valores reales en el repo): TLS/SASL vía
# SPRING_KAFKA_PROPERTIES_SECURITY_PROTOCOL, SPRING_KAFKA_PROPERTIES_SASL_MECHANISM,
# SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG
