APP_NAME=wa-accounts-service
APP_PORT=8084
DB_NAME=wa_accounts
DB_USERNAME=app
DB_PASSWORD=cambiar
# Puerto host → Postgres (5435 por defecto para no chocar con H1 5432 / H3 5433 / H2 5434)
