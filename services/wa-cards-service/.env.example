APP_NAME=wa-cards-service
APP_PORT=8086
DB_NAME=wa_cards
DB_USERNAME=app
DB_PASSWORD=cambiar
# Puerto host → Postgres (5437 por defecto para no chocar con H1 5432 / H3 5433 / H2 5434 / H4 5435 / H6 5436)
DB_HOST_PORT=5437
# H2 Credentials Service (desde el contenedor hacia el host)
CREDENTIALS_SERVICE_BASE_URL=http://host.docker.internal:8082
