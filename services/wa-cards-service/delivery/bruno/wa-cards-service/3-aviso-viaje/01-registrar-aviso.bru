meta {
  name: Registrar aviso de viaje
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/tarjetas/{{tarjetaId}}/aviso-viaje
  body: json
  auth: none
}

headers {
  X-Credencial-Sesion: {{credencial}}
  Content-Type: application/json
}

body:json {
  {
    "tarjetaId": "{{tarjetaId}}",
    "pais": "España",
    "region": "Madrid",
    "fechaDesde": "2026-12-01",
    "fechaHasta": "2026-12-15"
  }
}

assert {
  res.status: eq 201
}

docs {
  Registra país, región opcional y fechas; no cambia límites ni políticas de la tarjeta. Respuestas: 201, 400, 401, 403, 404.
}
