meta {
  name: Advertencia sin confirmaciones — 409
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/tarjetas/{{tarjetaId}}/bloquear/definitivo
  body: json
  auth: none
}

headers {
  X-Credencial-Sesion: {{credencial}}
  Content-Type: application/json
}

body:json {
  {
    "tarjetaId": "{{tarjetaId}}",
    "motivo": "ROBO"
  }
}

assert {
  res.status: eq 409
}

docs {
  Sin las dos confirmaciones no cambia la tarjeta; devuelve la advertencia de irreversibilidad para mostrar en el canal.
}
