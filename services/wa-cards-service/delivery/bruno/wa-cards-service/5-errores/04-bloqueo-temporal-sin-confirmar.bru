meta {
  name: Bloqueo temporal sin CONFIRMAR — 400
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/tarjetas/{{tarjetaId}}/bloquear/temporal
  body: json
  auth: none
}

headers {
  X-Credencial-Sesion: {{credencial}}
  Content-Type: application/json
}

body:json {
  {
    "tarjetaId": "{{tarjetaId}}",
    "confirmar": "NO"
  }
}

assert {
  res.status: eq 400
}

docs {
  Confirmación distinta de CONFIRMAR → 400 BAD_REQUEST y la tarjeta no cambia.
}
