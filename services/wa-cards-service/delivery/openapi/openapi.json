          "schema" : {
            "type" : "string",
            "format" : "uuid"
          },
          "example" : "11111111-1111-4111-8111-111111111111"
        }, {
          "name" : "X-Credencial-Sesion",
          "in" : "header",
          "description" : "Credencial JWT de sesión validada con H2; requiere vínculo activo",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "example" : "jwt-de-sesion"
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/BloqueoDefinitivoRequest"
              },
              "examples" : {
                "Robo" : {
                  "description" : "Robo",
                  "value" : {
                    "tarjetaId" : "11111111-1111-4111-8111-111111111111",
                    "motivo" : "ROBO",
                    "confirmarPrimero" : "CONFIRMAR",
                    "confirmarSegundo" : "CONFIRMAR"
                  }
                },
                "Extravio" : {
                  "description" : "Extravio",
                  "value" : {
                    "tarjetaId" : "11111111-1111-4111-8111-111111111111",
                    "motivo" : "EXTRAVIO",
                    "confirmarPrimero" : "CONFIRMAR",
                    "confirmarSegundo" : "CONFIRMAR"
                  }
                }
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Operación exitosa",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BloqueoDefinitivoResponse"
                },
                "examples" : {
                  "Exito" : {
                    "value" : {
                      "tarjeta" : {
                        "id" : "11111111-1111-4111-8111-111111111111",
                        "ultimosCuatro" : "1234",
                        "marca" : "VISA",
                        "tipo" : "CREDITO",
                        "estado" : "BLOQUEO_DEFINITIVO"
                      },
                      "mensaje" : "Bloqueo definitivo aplicado, irreversible por WhatsApp. Solicite la   reposición por los canales oficiales del banco."
                    }
                  }
                }
              }
            }
          },
          "400" : {
            "$ref" : "#/components/responses/400"
          },
          "401" : {
            "$ref" : "#/components/responses/401"
          },
          "403" : {
            "$ref" : "#/components/responses/403"
          },
          "404" : {
            "$ref" : "#/components/responses/404"
          },
          "409" : {
            "$ref" : "#/components/responses/409"
          },
          "500" : {
            "$ref" : "#/components/responses/500"
          }
        }
      }
    },
    "/api/v1/tarjetas/{tarjetaId}/aviso-viaje" : {
      "post" : {
        "tags" : [ "Tarjetas" ],
        "summary" : "Registrar aviso de viaje",
        "description" : "Registra el aviso confirmado; no reemplaza políticas internacionales del emisor ni límites del banco.",
        "operationId" : "registrar",
        "parameters" : [ {
          "name" : "tarjetaId",
          "in" : "path",
          "description" : "Identificador de la tarjeta del titular",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          },
          "example" : "11111111-1111-4111-8111-111111111111"
        }, {
          "name" : "X-Credencial-Sesion",
          "in" : "header",
          "description" : "Credencial JWT de sesión validada con H2; requiere vínculo activo",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "example" : "jwt-de-sesion"
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/AvisoViajeRequest"
              },
              "examples" : {
                "Solicitud" : {
                  "description" : "Solicitud",
                  "value" : {
