    "/api/v1/tarjetas/{tarjetaId}/consumos" : {
      "get" : {
        "tags" : [ "Tarjetas" ],
        "summary" : "Consultar consumos recientes",
        "description" : "Pagina por fecha e identificador descendentes con ventana congelada; sin datos sensibles.",
        "operationId" : "listar_1",
        "parameters" : [ {
          "name" : "tarjetaId",
          "in" : "path",
          "description" : "Identificador de la tarjeta del titular",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          },
          "example" : "11111111-1111-4111-8111-111111111111"
        }, {
          "name" : "X-Credencial-Sesion",
          "in" : "header",
          "description" : "Credencial JWT de sesión validada con H2; requiere vínculo activo",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "example" : "jwt-de-sesion"
        }, {
          "name" : "dias",
          "in" : "query",
          "description" : "Ventana en días; se limita al máximo configurado (90 por defecto)",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          },
          "example" : 30
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Cantidad por página; se limita al tope configurado (10 por defecto)",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          },
          "example" : 5
        }, {
          "name" : "cursor",
          "in" : "query",
          "description" : "Cursor opaco devuelto por la página anterior; omitir en la primera consulta",
          "required" : false,
          "schema" : {
            "type" : "string"
          },
          "example" : "MTExMTExMTEtMTExMS00MTExLTgxMTEtMTExMTExMTExMTExfDMwfDIwMjYtMTAtMzBUMTI6MDA6MDBafDIwMjYtMTAtMjlUMTI6MDA6MDBafDE"
        } ],
        "responses" : {
          "200" : {
            "description" : "Operación exitosa",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ConsumosPageResponse"
                },
                "examples" : {
                  "Exito" : {
                    "value" : {
                      "consumos" : [ {
                        "fecha" : "2026-10-30T12:00:00Z",
                        "comercio" : "Comercio de prueba",
                        "monto" : 1250.5,
                        "moneda" : "ARS",
                        "descripcion" : "Compra",
                        "referencia" : "COMPRA-001"
                      } ],
                      "tieneMas" : false,
                      "cursor" : null
                    }
                  }
                }
              }
            }
          },
          "400" : {
            "$ref" : "#/components/responses/400"
          },
          "401" : {
            "$ref" : "#/components/responses/401"
          },
          "403" : {
            "$ref" : "#/components/responses/403"
          },
          "404" : {
            "$ref" : "#/components/responses/404"
          },
          "500" : {
            "$ref" : "#/components/responses/500"
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "ErrorResponse" : {
        "description" : "Error uniforme de la API (code, message, details, timestamp)",
        "properties" : {
          "code" : {
            "type" : "string",
            "description" : "Código estable",
            "enum" : [ "VALIDATION_ERROR", "BAD_REQUEST", "NOT_FOUND", "CONFLICT", "INTERNAL_ERROR", "UNAUTHORIZED", "FORBIDDEN" ],
            "example" : "VALIDATION_ERROR"
          },
          "message" : {
            "type" : "string",
            "description" : "Mensaje legible sin datos sensibles",
            "example" : "La solicitud tiene datos inválidos"
          },
          "details" : {
            "type" : "array",
            "description" : "Detalles de validación; nunca null (lista vacía si no aplica)",
            "items" : {
              "$ref" : "#/components/schemas/FieldError"
            }
          },
          "timestamp" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "Instante UTC ISO-8601",
            "example" : "2026-10-26T12:00:00Z"
          }
        }
      },
      "FieldError" : {
        "description" : "Detalle de un campo inválido (sin el valor rechazado)",
        "properties" : {
          "field" : {
            "type" : "string",
            "description" : "Nombre del campo",
            "example" : "nombre"
          },
          "message" : {
            "type" : "string",
            "description" : "Motivo del rechazo",
            "example" : "El nombre es obligatorio"
          }
        }
      },
      "DesbloqueoRequest" : {
        "type" : "object",
        "properties" : {
          "tarjetaId" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "Identificador de tarjeta; debe coincidir con el path",
            "example" : "11111111-1111-4111-8111-111111111111"
          },
          "validacionAdicional" : {
            "type" : "boolean",
            "description" : "Resultado de la validación adicional exigida por el banco",
            "example" : true
          }
        },
        "required" : [ "tarjetaId" ]
      },
      "TarjetaResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "Identificador de la tarjeta",
            "example" : "11111111-1111-4111-8111-111111111111"
          },
          "ultimosCuatro" : {
            "type" : "string",
            "description" : "Últimos cuatro dígitos; nunca se expone el PAN",
            "example" : 1234
          },
          "marca" : {
            "type" : "string",
            "description" : "Marca de la tarjeta",
            "enum" : [ "VISA", "MASTERCARD", "AMEX" ],
            "example" : "VISA"
          },
          "tipo" : {
            "type" : "string",
            "description" : "Tipo de tarjeta",
            "enum" : [ "DEBITO", "CREDITO" ],
            "example" : "CREDITO"
          },
          "estado" : {
            "type" : "string",
            "description" : "Estado actual de la tarjeta",
            "enum" : [ "ACTIVA", "BLOQUEO_TEMPORAL", "BLOQUEO_DEFINITIVO" ],
            "example" : "ACTIVA"
          }
        }
      },
      "BloqueoTemporalRequest" : {
        "type" : "object",
        "properties" : {
          "tarjetaId" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "Identificador de tarjeta; debe coincidir con el path",
            "example" : "11111111-1111-4111-8111-111111111111"
          },
          "confirmar" : {
            "type" : "string",
            "description" : "Confirmación exacta CONFIRMAR",
            "example" : "CONFIRMAR"
          }
        },
        "required" : [ "tarjetaId" ]
      },
      "BloqueoTemporalResponse" : {
        "type" : "object",
        "properties" : {
          "tarjetaId" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "Identificador de tarjeta; debe coincidir con el path",
            "example" : "11111111-1111-4111-8111-111111111111"
          },
          "estado" : {
            "type" : "string",
            "description" : "Estado actual de la tarjeta",
            "enum" : [ "ACTIVA", "BLOQUEO_TEMPORAL", "BLOQUEO_DEFINITIVO" ],
            "example" : "BLOQUEO_TEMPORAL"
          },
          "mensaje" : {
            "type" : "string",
            "description" : "Orientación al cliente",
            "example" : "Tarjeta bloqueada temporalmente. Para desbloquearla, indicá DESBLOQUEAR."
          }
        }
      },
      "BloqueoDefinitivoRequest" : {
        "type" : "object",
        "properties" : {
          "tarjetaId" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "Identificador de tarjeta; debe coincidir con el path",
            "example" : "11111111-1111-4111-8111-111111111111"
          },
          "motivo" : {
            "type" : "string",
            "description" : "Motivo: ROBO o EXTRAVIO",
            "example" : "ROBO"
          },
          "confirmarPrimero" : {
            "type" : "string",
            "description" : "Primera confirmación exacta CONFIRMAR",
            "example" : "CONFIRMAR"
          },
          "confirmarSegundo" : {
            "type" : "string",
            "description" : "Segunda confirmación exacta CONFIRMAR",
            "example" : "CONFIRMAR"
          }
        },
        "required" : [ "tarjetaId" ]
      },
      "BloqueoDefinitivoResponse" : {
        "type" : "object",
        "properties" : {
          "tarjeta" : {
            "$ref" : "#/components/schemas/TarjetaResponse",
            "description" : "Tarjeta con su estado actualizado"
          },
          "mensaje" : {
            "type" : "string",
            "description" : "Orientación al cliente",
            "example" : "Bloqueo definitivo aplicado, irreversible por WhatsApp. Solicite la reposición por los canales oficiales del banco."
          }
        }
      },
      "AvisoViajeRequest" : {
        "type" : "object",
        "properties" : {
          "tarjetaId" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "Identificador de tarjeta; debe coincidir con el path",
            "example" : "11111111-1111-4111-8111-111111111111"
          },
          "pais" : {
            "type" : "string",
            "description" : "País de destino",
            "example" : "España",
            "maxLength" : 255,
            "minLength" : 0
          },
          "region" : {
            "type" : "string",
            "description" : "Región de destino opcional",
            "example" : "Madrid",
            "maxLength" : 255,
            "minLength" : 0
          },
          "fechaDesde" : {
