  "paths" : {
    "/api/v1/tarjetas/{tarjetaId}/desbloquear/temporal" : {
      "post" : {
        "tags" : [ "Tarjetas" ],
        "summary" : "Desbloquear temporalmente",
        "description" : "Exige validación adicional según configuración. Un bloqueo definitivo no se revierte por chat.",
        "operationId" : "desbloquearTemporal",
        "parameters" : [ {
          "name" : "tarjetaId",
          "in" : "path",
          "description" : "Identificador de la tarjeta del titular",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          },
          "example" : "11111111-1111-4111-8111-111111111111"
        }, {
          "name" : "X-Credencial-Sesion",
          "in" : "header",
          "description" : "Credencial JWT de sesión validada con H2; requiere vínculo activo",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "example" : "jwt-de-sesion"
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/DesbloqueoRequest"
              },
              "examples" : {
                "Solicitud" : {
                  "description" : "Solicitud",
                  "value" : {
                    "tarjetaId" : "11111111-1111-4111-8111-111111111111",
                    "validacionAdicional" : true
                  }
                }
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Operación exitosa",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TarjetaResponse"
                },
                "examples" : {
                  "Exito" : {
                    "value" : {
                      "id" : "11111111-1111-4111-8111-111111111111",
                      "ultimosCuatro" : "1234",
                      "marca" : "VISA",
                      "tipo" : "CREDITO",
                      "estado" : "ACTIVA"
                    }
                  }
                }
              }
            }
          },
          "400" : {
            "$ref" : "#/components/responses/400"
          },
          "401" : {
            "$ref" : "#/components/responses/401"
          },
          "403" : {
            "$ref" : "#/components/responses/403"
          },
          "404" : {
            "$ref" : "#/components/responses/404"
          },
          "409" : {
            "$ref" : "#/components/responses/409"
          },
          "500" : {
            "$ref" : "#/components/responses/500"
          }
        }
      }
    },
