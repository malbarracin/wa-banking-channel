meta {
  name: Verificación 3 - falla, quedan 0
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/vinculos/{{numeroWhatsapp}}/verificaciones
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "documentoTipo": "{{docTipo}}",
    "documentoNumero": "{{docNumber}}",
    "datosVerificacion": { "codigo": "123456" }
  }
}

assert {
  res.status: eq 200
}

docs {
  Tercer fallo de la ventana: exitosa=false, intentosRestantes=0. El siguiente intento queda bloqueado.
}
