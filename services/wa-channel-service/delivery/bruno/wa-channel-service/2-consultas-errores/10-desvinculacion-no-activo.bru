meta {
  name: Desvinculación sobre no activo - 409
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/api/v1/vinculos/{{numeroWhatsapp}}/desvinculacion
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Canal-Credencial-Token: {{credencialSesion}}
}

body:json {
  {
    "confirmacion": true
  }
}

assert {
  res.status: eq 409
}

docs {
  Solo se desvincula desde ACTIVO o BLOQUEADO. Esperado: code CONFLICT.
}
