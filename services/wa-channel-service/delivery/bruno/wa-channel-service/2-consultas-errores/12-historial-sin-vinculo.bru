meta {
  name: Historial sin vínculo - 404
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/vinculos/{{numeroSinVinculo}}/historial
  body: none
  auth: none
}

assert {
  res.status: eq 404
}

docs {
  Número sin ningún vínculo registrado.
  Esperado: code NOT_FOUND, mensaje "No existe un vínculo registrado para el número consultado".
}
