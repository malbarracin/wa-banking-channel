APP_NAME=wa-credentials-service
APP_PORT=8082
DB_NAME=wa_credentials
DB_USERNAME=app
DB_PASSWORD=cambiar
# Puerto host → Postgres (5434 por defecto para no chocar con wa-users 5432 / wa-channel 5433)
DB_HOST_PORT=5434
# JWT HS256: al menos 32 bytes UTF-8 (obligatorio; sin default en la app)
CREDENTIAL_JWT_SECRET=cambiar-por-clave-de-al-menos-32-bytes
# H1 Users Service (desde el contenedor hacia el host)
WA_USERS_SERVICE_BASE_URL=http://host.docker.internal:8080
