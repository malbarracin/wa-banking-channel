meta {
  name: Emitir credencial
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/credenciales/emitir
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{h3ServiceToken}}
}

body:json {
  {
    "numeroWhatsapp": "{{numeroWhatsapp}}",
    "documentoTipo": "{{docTipo}}",
    "documentoNumero": "{{docNumber}}",
    "vinculoActivo": true,
    "identidadVerificada": true
  }
}

assert {
  res.status: eq 201
  res.body.credencial: isString
  res.body.fechaExpiracion: isString
}

script:post-response {
  bru.setVar("jwt", res.body.credencial);
  bru.setVar("fechaExpiracion", res.body.fechaExpiracion);
}

docs {
  Solo H3: Authorization Bearer con h3ServiceToken (mismo valor que CREDENTIAL_H3_SERVICE_TOKEN).
  Requiere confirmaciones verdaderas y cliente ACTIVE en H1.
  Invalida la credencial ACTIVA anterior del número (motivo REEMPLAZO).
  Respuestas: 201 emitida, 400 datos inválidos, 401 sin autenticar, 403 no autorizada, 404 cliente inexistente, 409 conflicto, 503 H1 caído.
}
