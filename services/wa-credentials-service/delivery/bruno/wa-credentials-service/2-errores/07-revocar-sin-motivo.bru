meta {
  name: Revocar sin motivo
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/credenciales/{{numeroWhatsapp}}/revocacion
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "solicitadoPor": "CANAL"
  }
}

assert {
  res.status: eq 400
  res.body.code: eq VALIDATION_ERROR
}

docs {
  El motivo es obligatorio.
  Respuestas: 400 VALIDATION_ERROR.
}
