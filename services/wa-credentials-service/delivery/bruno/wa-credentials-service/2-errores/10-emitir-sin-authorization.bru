meta {
  name: Emitir sin Authorization
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/credenciales/emitir
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "numeroWhatsapp": "{{numeroWhatsapp}}",
    "documentoTipo": "{{docTipo}}",
    "documentoNumero": "{{docNumber}}",
    "vinculoActivo": true,
    "identidadVerificada": true
  }
}

assert {
  res.status: eq 401
  res.body.code: eq UNAUTHORIZED
}

docs {
  Las operaciones de H3 exigen Authorization Bearer con h3ServiceToken; sin cabecera la respuesta es 401.
}
