meta {
  name: Revocación masiva con secreto de H3
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/credenciales/revocacion-masiva
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{h3ServiceToken}}
}

body:json {
  {
    "criterio": "POR_CLIENTE",
    "segmento": {
      "documentoTipo": "{{docTipo}}",
      "documentoNumero": "{{docNumber}}"
    }
  }
}

assert {
  res.status: eq 403
  res.body.code: eq FORBIDDEN
}

docs {
  La revocación masiva es del banco: el secreto de H3 se rechaza con 403.
}
