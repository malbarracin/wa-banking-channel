meta {
  name: Confirmar recepción de renovación
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/credenciales/renovacion/confirmar
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "credencial": "{{jwtNuevo}}"
  }
}

assert {
  res.status: eq 204
}

docs {
  H3 presenta el JWT nuevo después de guardarlo. Activa el reemplazo y revoca el anterior.
  Idempotente: repetir con el mismo JWT vigente responde 204.
  Respuestas: 204, 400, 401, 409, 500.
}
