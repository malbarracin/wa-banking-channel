{
  "info": {
    "name": "wa-credentials-service",
    "description": "API H2 de acceso y sesión. Orden sugerido: 0. Preparación H1 → 1. Flujo feliz → 2. Errores → 3. Salud. La carpeta 0 crea un cliente ACTIVE en H1 con documento y número únicos por corrida (H1 debe estar disponible).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8082" },
    { "key": "h1BaseUrl", "value": "http://localhost:8080" },
    { "key": "docTipo", "value": "DNI" },
    { "key": "docNumber", "value": "30111222" },
    { "key": "numeroWhatsapp", "value": "+5491111111111" },
    { "key": "numeroSinHistorial", "value": "+5491100000000" },
    { "key": "docInexistente", "value": "00000000" },
    { "key": "jwt", "value": "" },
    { "key": "fechaExpiracion", "value": "" }
  ],
  "item": [
    {
      "name": "0. Preparación H1",
      "description": "Crea un cliente ACTIVE en wa-users-service (H1) con documento y número únicos por corrida. Requiere H1 en h1BaseUrl. Sin esta carpeta, emisión y validación fallan.",
      "item": [
        {
          "name": "Crear cliente ACTIVE en H1",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = String(10000000 + (Date.now() % 90000000));",
                  "pm.collectionVariables.set('docNumber', suffix);",
                  "pm.collectionVariables.set('numeroWhatsapp', '+54911' + suffix);",
                  "pm.collectionVariables.set('numeroSinHistorial', '+54912' + String(20000000 + (Date.now() % 70000000)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('cliente ACTIVE', () => pm.expect(body.estado).to.eql('ACTIVE'));",
                  "pm.test('documento generado', () => pm.expect(body.documento.numero).to.eql(pm.collectionVariables.get('docNumber')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documento\": { \"tipo\": \"{{docTipo}}\", \"numero\": \"{{docNumber}}\" },\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Pérez\",\n  \"fechaNacimiento\": \"1990-05-15\",\n  \"email\": \"ana.{{docNumber}}@example.test\",\n  \"telefono\": \"5551234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{h1BaseUrl}}/api/v1/users",
              "host": ["{{h1BaseUrl}}"],
              "path": ["api", "v1", "users"]
            },
            "description": "Alta en H1. Genera docNumber y numeroWhatsapp únicos por corrida. Si se omite esta carpeta, el documento de docNumber debe existir y estar ACTIVE en H1."
          },
          "response": [
            {
              "name": "201 - cliente creado",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"id\": \"b7c1d2e3-f4a5-4b6c-8d7e-9f0a1b2c3d4e\",\n  \"documento\": { \"tipo\": \"DNI\", \"numero\": \"48112233\" },\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Pérez\",\n  \"fechaNacimiento\": \"1990-05-15\",\n  \"email\": \"ana.48112233@example.test\",\n  \"telefono\": \"5551234\",\n  \"nombreTratamiento\": null,\n  \"preferencias\": null,\n  \"estado\": \"ACTIVE\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "1. Flujo feliz",
      "description": "Emisión, validación, historial, revocación individual y revocación masiva por cliente. Ejecutar la carpeta 0 antes.",
      "item": [
        {
          "name": "Emitir credencial",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('devuelve credencial', () => pm.expect(body.credencial).to.be.a('string'));",
                  "pm.test('devuelve expiración', () => pm.expect(body.fechaExpiracion).to.be.a('string'));",
                  "pm.collectionVariables.set('jwt', body.credencial);",
                  "pm.collectionVariables.set('fechaExpiracion', body.fechaExpiracion);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroWhatsapp\": \"{{numeroWhatsapp}}\",\n  \"documentoTipo\": \"{{docTipo}}\",\n  \"documentoNumero\": \"{{docNumber}}\",\n  \"vinculoActivo\": true,\n  \"identidadVerificada\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/credenciales/emitir",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "credenciales", "emitir"]
            },
            "description": "Requiere confirmaciones verdaderas y cliente ACTIVE en H1. Invalida la credencial ACTIVA anterior del número (motivo REEMPLAZO)."
          },
          "response": [
            {
              "name": "201 - credencial emitida",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"credencial\": \"JWT_DEVUELTO_POR_EMITIR\",\n  \"fechaExpiracion\": \"2026-10-27T12:00:00Z\"\n}"
            }
          ]
        },
        {
          "name": "Validar credencial",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('vigente', () => pm.expect(body.vigente).to.eql(true));",
                  "pm.test('mismo número', () => pm.expect(body.numeroWhatsapp).to.eql(pm.collectionVariables.get('numeroWhatsapp')));",
                  "pm.test('mismo documento', () => pm.expect(body.documentoNumero).to.eql(pm.collectionVariables.get('docNumber')));",
                  "pm.test('misma expiración', () => pm.expect(body.fechaExpiracion).to.eql(pm.collectionVariables.get('fechaExpiracion')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credencial\": \"{{jwt}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/credenciales/validar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "credenciales", "validar"]
            },
            "description": "Usa el JWT guardado por la emisión. Verifica firma, expiración, jti, estado persistido y cliente en H1."
          },
          "response": [
            {
              "name": "200 - credencial vigente",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"vigente\": true,\n  \"numeroWhatsapp\": \"+5491111111111\",\n  \"documentoTipo\": \"DNI\",\n  \"documentoNumero\": \"12345678\",\n  \"fechaExpiracion\": \"2026-10-27T12:00:00Z\"\n}"
            }
          ]
        },
        {
          "name": "Consultar historial",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('estado ACTIVA', () => pm.expect(body.estadoActual).to.eql('ACTIVA'));",
                  "pm.test('con eventos', () => pm.expect(body.eventos).to.be.an('array').that.is.not.empty);",
                  "pm.test('sin jti ni JWT', () => { const raw = pm.response.text(); pm.expect(raw).to.not.include('jti'); pm.expect(raw).to.not.include('credencial'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/credenciales/{{numeroWhatsapp}}/historial",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "credenciales", "{{numeroWhatsapp}}", "historial"]
            },
            "description": "Estado efectivo y eventos del número, del más reciente al más antiguo. No devuelve el JWT."
          },
          "response": [
            {
              "name": "200 - historial",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"numeroWhatsapp\": \"+5491111111111\",\n  \"documentoTipo\": \"DNI\",\n  \"documentoNumero\": \"12345678\",\n  \"estadoActual\": \"ACTIVA\",\n  \"eventos\": [\n    {\n      \"accion\": \"EMISION\",\n      \"resultado\": \"EXITOSO\",\n      \"fecha\": \"2026-10-26T12:00:00Z\",\n      \"motivo\": \"EMISION\"\n    }\n  ]\n}"
            }
          ]
        },
        {
          "name": "Revocar credencial",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));",
                  "pm.test('sin cuerpo', () => pm.expect(pm.response.text()).to.eql(''));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motivo\": \"DESVINCULACION\",\n  \"solicitadoPor\": \"CANAL\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/credenciales/{{numeroWhatsapp}}/revocacion",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "credenciales", "{{numeroWhatsapp}}", "revocacion"]
            },
            "description": "Revocación inmediata. Sin credencial activa responde 404. La credencial revocada deja de validar al instante."
          },
          "response": [
            {
              "name": "204 - revocada",
              "status": "No Content",
              "code": 204,
              "header": [],
              "_postman_previewlanguage": "text",
              "body": ""
            }
          ]
        },
        {
          "name": "Emitir nueva credencial",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('devuelve credencial', () => pm.expect(body.credencial).to.be.a('string'));",
                  "pm.collectionVariables.set('jwt', body.credencial);",
                  "pm.collectionVariables.set('fechaExpiracion', body.fechaExpiracion);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroWhatsapp\": \"{{numeroWhatsapp}}\",\n  \"documentoTipo\": \"{{docTipo}}\",\n  \"documentoNumero\": \"{{docNumber}}\",\n  \"vinculoActivo\": true,\n  \"identidadVerificada\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/credenciales/emitir",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "credenciales", "emitir"]
            },
            "description": "Deja una credencial ACTIVA nueva para probar la revocación masiva."
          },
          "response": [
            {
              "name": "201 - nueva credencial",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"credencial\": \"JWT_DEVUELTO_POR_EMITIR_2\",\n  \"fechaExpiracion\": \"2026-10-27T12:00:00Z\"\n}"
            }
          ]
        },
        {
          "name": "Revocación masiva por cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('revocó al menos una', () => pm.expect(body.revocadas).to.be.at.least(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"criterio\": \"POR_CLIENTE\",\n  \"segmento\": {\n    \"documentoTipo\": \"{{docTipo}}\",\n    \"documentoNumero\": \"{{docNumber}}\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/credenciales/revocacion-masiva",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "credenciales", "revocacion-masiva"]
            },
            "description": "Revoca todas las credenciales ACTIVA del cliente. Devuelve la cantidad revocada; la operación es idempotente."
          },
          "response": [
            {
              "name": "200 - revocadas",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"revocadas\": 1\n}"
            }
          ]
        },
        {
          "name": "Revocación masiva repetida",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('idempotente: 0 revocadas', () => pm.expect(pm.response.json().revocadas).to.eql(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"criterio\": \"POR_CLIENTE\",\n  \"segmento\": {\n    \"documentoTipo\": \"{{docTipo}}\",\n    \"documentoNumero\": \"{{docNumber}}\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/credenciales/revocacion-masiva",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "credenciales", "revocacion-masiva"]
            },
            "description": "Repite el mismo alcance: no quedan credenciales ACTIVA y devuelve 0."
          },
          "response": [
            {
              "name": "200 - sin credenciales activas",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"revocadas\": 0\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "2. Errores",
      "description": "Errores esperados después de ejecutar la carpeta 1. Los casos 503 y cliente SUSPENDED requieren intervención en H1 (ver qa-manual.md).",
      "item": [
        {
          "name": "Validar credencial revocada",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('code UNAUTHORIZED', () => pm.expect(pm.response.json().code).to.eql('UNAUTHORIZED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credencial\": \"{{jwt}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/credenciales/validar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "credenciales", "validar"]
            },
            "description": "El JWT de la última emisión quedó revocado por la revocación masiva."
          },
          "response": [
            {
              "name": "401 - credencial rechazada",
              "status": "Unauthorized",
              "code": 401,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"code\": \"UNAUTHORIZED\",\n  \"message\": \"La credencial no es válida; se requiere verificar la identidad nuevamente\",\n  \"details\": [],\n  \"timestamp\": \"2026-10-26T12:00:00Z\"\n}"
            }
          ]
        },
        {
          "name": "Validar JWT malformado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('code UNAUTHORIZED', () => pm.expect(pm.response.json().code).to.eql('UNAUTHORIZED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credencial\": \"no-es-un-jwt\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/credenciales/validar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "credenciales", "validar"]
            },
            "description": "Credencial con formato inválido: rechazo uniforme 401."
          },
          "response": [
            {
              "name": "401 - formato inválido",
              "status": "Unauthorized",
              "code": 401,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"code\": \"UNAUTHORIZED\",\n  \"message\": \"La credencial no es válida; se requiere verificar la identidad nuevamente\",\n  \"details\": [],\n  \"timestamp\": \"2026-10-26T12:00:00Z\"\n}"
            }
          ]
        },
        {
          "name": "Emitir sin confirmaciones",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', () => pm.response.to.have.status(403));",
                  "pm.test('code FORBIDDEN', () => pm.expect(pm.response.json().code).to.eql('FORBIDDEN'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroWhatsapp\": \"{{numeroWhatsapp}}\",\n  \"documentoTipo\": \"{{docTipo}}\",\n  \"documentoNumero\": \"{{docNumber}}\",\n  \"vinculoActivo\": true,\n  \"identidadVerificada\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/credenciales/emitir",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "credenciales", "emitir"]
            },
            "description": "identidadVerificada=false: la emisión se rechaza sin crear credencial."
          },
          "response": [
            {
              "name": "403 - emisión no autorizada",
              "status": "Forbidden",
              "code": 403,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"code\": \"FORBIDDEN\",\n  \"message\": \"La emisión requiere identidad verificada, vínculo activo y cliente activo\",\n  \"details\": [],\n  \"timestamp\": \"2026-10-26T12:00:00Z\"\n}"
            }
          ]
        },
        {
          "name": "Emitir con número inválido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('code VALIDATION_ERROR', () => pm.expect(pm.response.json().code).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroWhatsapp\": \"5491111111111\",\n  \"documentoTipo\": \"{{docTipo}}\",\n  \"documentoNumero\": \"{{docNumber}}\",\n  \"vinculoActivo\": true,\n  \"identidadVerificada\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/credenciales/emitir",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "credenciales", "emitir"]
            },
            "description": "Número sin '+' inicial: no cumple E.164."
          },
          "response": [
            {
              "name": "400 - número inválido",
              "status": "Bad Request",
              "code": 400,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"code\": \"VALIDATION_ERROR\",\n  \"message\": \"La solicitud tiene datos inválidos\",\n  \"details\": [\n    { \"field\": \"numeroWhatsapp\", \"message\": \"no cumple el formato E.164\" }\n  ],\n  \"timestamp\": \"2026-10-26T12:00:00Z\"\n}"
            }
          ]
        },
        {
          "name": "Emitir con cliente inexistente en H1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('code NOT_FOUND', () => pm.expect(pm.response.json().code).to.eql('NOT_FOUND'));",
                  "pm.test('cliente inexistente', () => pm.expect(pm.response.json().message).to.eql('El cliente no existe'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
