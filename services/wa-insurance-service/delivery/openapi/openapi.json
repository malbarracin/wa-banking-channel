      }
    },
    "examples" : {
      "ValidationError" : {
        "value" : "{\n  \"code\": \"VALIDATION_ERROR\",\n  \"message\": \"La solicitud tiene datos inválidos\",\n  \"details\": [\n    { \"field\": \"descripcion\", \"message\": \"no debe estar vacío\" }\n  ],\n  \"timestamp\": \"2026-10-26T12:00:00Z\"\n}"
