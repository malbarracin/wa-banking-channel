# Copiar a .env, completar DB_PASSWORD con un valor local; nunca versionar .env.
APP_NAME=wa-users-service
# Puerto publicado en el host; el contenedor siempre escucha 8080.
APP_PORT=8080
DB_NAME=wa_users
DB_USERNAME=app
DB_PASSWORD=
# PostgreSQL publicado solo en loopback para el perfil dev.
DB_PORT=5432
