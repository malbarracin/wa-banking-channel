# Copiar a .env (no se commitea) y completar con valores reales.
APP_NAME=wa-users-service
# Puerto de la PC donde se publica la app (dentro del contenedor siempre escucha en 8080)
APP_PORT=8080
DB_NAME=wa_users
# Puerto de la PC donde se publica PostgreSQL (lo usa el perfil dev)
DB_PORT=5432
DB_USERNAME=app
DB_PASSWORD=cambiar
