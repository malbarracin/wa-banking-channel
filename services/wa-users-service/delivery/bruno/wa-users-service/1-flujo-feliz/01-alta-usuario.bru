meta {
  name: Alta de usuario
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/users
  body: json
  auth: none
}

body:json {
  {
    "documentType": "DNI",
    "documentNumber": "{{docNumber}}",
    "displayName": "Ana Pérez",
    "email": "ana@example.com",
    "birthDate": "1990-01-02"
  }
}

script:pre-request {
  bru.setVar("docNumber", String(Date.now()).slice(-8));
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("userId", res.body.id);
}

docs {
  Crea un usuario ACTIVE. Genera docNumber único y guarda userId. Respuestas: 201, 400, 409.
}
