meta {
  name: Alta sin nombre — 400 VALIDATION_ERROR
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "documento": { "tipo": "DNI", "numero": "99900001" },
    "nombre": "",
    "apellido": "Pérez",
    "fechaNacimiento": "1990-05-15",
    "email": "ana@example.test"
  }
}

assert {
  res.status: eq 400
}

docs {
  Esperado: code VALIDATION_ERROR.
}
