meta {
  name: Alta documento duplicado (409)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/users
  body: json
  auth: none
}

body:json {
  {
    "documentType": "DNI",
    "documentNumber": "{{docNumber}}",
    "displayName": "Duplicado",
    "email": "dup@example.com",
    "birthDate": "1990-01-02"
  }
}

assert {
  res.status: eq 409
}

docs {
  CONFLICT: mismo tipo + número ya registrado (usar docNumber del flujo feliz).
}
