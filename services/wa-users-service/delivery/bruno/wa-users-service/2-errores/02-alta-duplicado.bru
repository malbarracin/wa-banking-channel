meta {
  name: Alta documento duplicado — 409 CONFLICT
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "documento": { "tipo": "{{docTipo}}", "numero": "{{docNumber}}" },
    "nombre": "Ana",
    "apellido": "Pérez",
    "fechaNacimiento": "1990-05-15",
    "email": "otra@example.test"
  }
}

assert {
  res.status: eq 409
}

docs {
  Requiere haber corrido el flujo feliz. Esperado: code CONFLICT.
}
