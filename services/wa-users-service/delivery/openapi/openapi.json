  "components" : {
    "schemas" : {
      "ErrorResponse" : {
        "type" : "object",
        "description" : "Contrato único de error HTTP de la API",
        "properties" : {
          "code" : {
            "type" : "string",
            "description" : "Código estable del error",
            "enum" : [ "VALIDATION_ERROR", "BAD_REQUEST", "NOT_FOUND", "CONFLICT", "INTERNAL_ERROR" ],
            "example" : "VALIDATION_ERROR"
          },
          "message" : {
            "type" : "string",
            "description" : "Mensaje público seguro",
            "example" : "La solicitud tiene datos inválidos"
          },
          "details" : {
            "type" : "array",
            "description" : "Detalle por campo; nunca null (puede ser lista vacía)",
            "items" : {
              "$ref" : "#/components/schemas/FieldError"
            }
          },
          "timestamp" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "Marca de tiempo UTC ISO-8601",
            "example" : "2026-10-05T14:30:00Z"
          }
        }
      },
      "CreateUserRequest" : {
        "type" : "object",
        "properties" : {
          "documentType" : {
            "type" : "string",
            "description" : "Tipo de documento de identidad",
            "enum" : [ "DNI", "PASSPORT", "LC", "LE", "CUIT" ],
            "example" : "DNI",
            "minLength" : 1,
            "pattern" : "DNI|PASSPORT|LC|LE|CUIT"
          },
          "documentNumber" : {
            "type" : "string",
            "description" : "Número de documento, alfanumérico sin espacios",
            "example" : "30111222",
            "maxLength" : 64,
            "minLength" : 0,
            "pattern" : "[A-Za-z0-9]+"
          },
          "displayName" : {
            "type" : "string",
