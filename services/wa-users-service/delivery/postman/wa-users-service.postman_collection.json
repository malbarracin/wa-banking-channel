              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Location del recurso', () => pm.expect(pm.response.headers.get('Location')).to.include('/api/v1/users/'));",
                  "const body = pm.response.json();",
                  "pm.test('estado ACTIVE', () => pm.expect(body.estado).to.eql('ACTIVE'));",
                  "pm.test('devuelve id', () => pm.expect(body.id).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
