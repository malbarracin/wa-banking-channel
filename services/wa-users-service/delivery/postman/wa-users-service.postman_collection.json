        {
          "name": "Cambio de estado — transición inválida (409)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Requiere userId en BAJA_LOGICA o intentar BAJA_LOGICA→ACTIVO.",
