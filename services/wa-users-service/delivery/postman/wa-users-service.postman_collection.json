            }
          ]
        },
        {
          "name": "Alta — documento duplicado (409 CONFLICT)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const doc = pm.collectionVariables.get('docNumber') || String(Date.now()).slice(-8);",
                  "pm.collectionVariables.set('dupDoc', doc);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 CONFLICT', () => {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json().code).to.eql('CONFLICT');",
                  "});"
                ]
