{
  "info": {
    "name": "wa-users-service",
    "description": "API H1 de usuarios bancarios del canal WhatsApp. Orden sugerido: 1. Flujo feliz → 2. Errores → 3. Salud. Sin JWT ni secretos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "userId", "value": "" },
    { "key": "docNumber", "value": "" }
  ],
  "item": [
    {
      "name": "1. Flujo feliz",
      "description": "Alta → consulta → actualización → cambio de estado → aptitud de canal.",
      "item": [
        {
          "name": "Alta de usuario (mínimo)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('docNumber', String(Date.now()).slice(-8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('estado ACTIVO y apto', () => {",
                  "  pm.expect(body.status).to.eql('ACTIVO');",
                  "  pm.expect(body.aptoParaVinculoCanal).to.eql(true);",
                  "  pm.expect(body.id).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('userId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoDocumento\": \"DNI\",\n  \"numeroDocumento\": \"{{docNumber}}\",\n  \"nombreTratamiento\": \"Ana Pérez\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users"]
            },
            "description": "Crea usuario ACTIVO. Unicidad por tipo+número de documento. 201, 400, 409."
          },
          "response": [
            {
              "name": "201 - creado",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"tipoDocumento\": \"DNI\",\n  \"numeroDocumento\": \"30111222\",\n  \"nombreTratamiento\": \"Ana Pérez\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/users",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "users"]
                }
              },
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"id\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\",\n  \"tipoDocumento\": \"DNI\",\n  \"numeroDocumento\": \"30111222\",\n  \"nombreTratamiento\": \"Ana Pérez\",\n  \"email\": null,\n  \"telefonoContacto\": null,\n  \"preferencias\": {},\n  \"status\": \"ACTIVO\",\n  \"aptoParaVinculoCanal\": true,\n  \"createdAt\": \"2026-10-15T12:00:00Z\",\n  \"updatedAt\": \"2026-10-15T12:00:00Z\",\n  \"historialResumido\": []\n}"
            }
          ]
        },
        {
          "name": "Consultar usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('incluye historial', () => pm.expect(body.historialResumido).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}"]
            },
            "description": "Consulta por UUID con historial resumido (hasta 20). 200, 400, 404."
          },
          "response": [
            {
              "name": "200 - encontrado",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/users/a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "users", "a1b2c3d4-e5f6-7890-abcd-ef1234567890"]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"id\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\",\n  \"tipoDocumento\": \"DNI\",\n  \"numeroDocumento\": \"30111222\",\n  \"nombreTratamiento\": \"Ana Pérez\",\n  \"email\": \"ana.perez@example.com\",\n  \"telefonoContacto\": \"+5491112345678\",\n  \"preferencias\": {\"idioma\": \"es\"},\n  \"status\": \"ACTIVO\",\n  \"aptoParaVinculoCanal\": true,\n  \"createdAt\": \"2026-10-15T12:00:00Z\",\n  \"updatedAt\": \"2026-10-15T12:00:00Z\",\n  \"historialResumido\": [\n    {\n      \"occurredAt\": \"2026-10-15T12:00:00Z\",\n      \"action\": \"ALTA\",\n      \"result\": \"OK\",\n      \"detail\": \"OPERACION_CONFIRMADA\"\n    }\n  ]\n}"
            }
          ]
        },
        {
          "name": "Actualizar datos permitidos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('email actualizado', () => pm.expect(body.email).to.eql('ana.perez@example.com'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreTratamiento\": \"Ana Pérez\",\n  \"email\": \"ana.perez@example.com\",\n  \"telefonoContacto\": \"+5491112345678\",\n  \"preferencias\": {\"idioma\": \"es\"}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}"]
            },
            "description": "Solo campos permitidos. 200, 400, 404."
          },
          "response": [
            {
              "name": "200 - actualizado",
              "originalRequest": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nombreTratamiento\": \"Ana Pérez\",\n  \"email\": \"ana.perez@example.com\",\n  \"telefonoContacto\": \"+5491112345678\",\n  \"preferencias\": {\"idioma\": \"es\"}\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/users/a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "users", "a1b2c3d4-e5f6-7890-abcd-ef1234567890"]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"id\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\",\n  \"tipoDocumento\": \"DNI\",\n  \"numeroDocumento\": \"30111222\",\n  \"nombreTratamiento\": \"Ana Pérez\",\n  \"email\": \"ana.perez@example.com\",\n  \"telefonoContacto\": \"+5491112345678\",\n  \"preferencias\": {\"idioma\": \"es\"},\n  \"status\": \"ACTIVO\",\n  \"aptoParaVinculoCanal\": true,\n  \"createdAt\": \"2026-10-15T12:00:00Z\",\n  \"updatedAt\": \"2026-10-15T12:00:00Z\",\n  \"historialResumido\": [\n    {\n      \"occurredAt\": \"2026-10-15T12:00:00Z\",\n      \"action\": \"ACTUALIZACION\",\n      \"result\": \"OK\",\n      \"detail\": \"OPERACION_CONFIRMADA\"\n    }\n  ]\n}"
            }
          ]
        },
        {
          "name": "Cambiar estado a SUSPENDIDO",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('suspendido no apto', () => {",
                  "  pm.expect(body.status).to.eql('SUSPENDIDO');",
                  "  pm.expect(body.aptoParaVinculoCanal).to.eql(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SUSPENDIDO\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}", "status"]
            },
            "description": "Matriz H1: ACTIVO↔SUSPENDIDO; ACTIVO|SUSPENDIDO→BAJA_LOGICA. 200, 400, 404, 409."
          },
          "response": [
            {
              "name": "200 - suspendido",
              "originalRequest": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"status\": \"SUSPENDIDO\"\n}" },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/users/a1b2c3d4-e5f6-7890-abcd-ef1234567890/status",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "users", "a1b2c3d4-e5f6-7890-abcd-ef1234567890", "status"]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"id\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\",\n  \"tipoDocumento\": \"DNI\",\n  \"numeroDocumento\": \"30111222\",\n  \"nombreTratamiento\": \"Ana Pérez\",\n  \"email\": \"ana.perez@example.com\",\n  \"telefonoContacto\": \"+5491112345678\",\n  \"preferencias\": {\"idioma\": \"es\"},\n  \"status\": \"SUSPENDIDO\",\n  \"aptoParaVinculoCanal\": false,\n  \"createdAt\": \"2026-10-15T12:00:00Z\",\n  \"updatedAt\": \"2026-10-15T12:05:00Z\",\n  \"historialResumido\": [\n    {\n      \"occurredAt\": \"2026-10-15T12:05:00Z\",\n      \"action\": \"CAMBIO_ESTADO\",\n      \"result\": \"OK\",\n      \"detail\": \"OPERACION_CONFIRMADA\"\n    }\n  ]\n}"
            }
          ]
        },
        {
          "name": "Consultar aptitud de canal",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('no apto si suspendido', () => pm.expect(body.aptoParaVinculoCanal).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}/channel-eligibility",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}", "channel-eligibility"]
            },
            "description": "Contrato mínimo para H3: userId, status, aptoParaVinculoCanal. 200, 400, 404."
          },
          "response": [
            {
              "name": "200 - no apto",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/users/a1b2c3d4-e5f6-7890-abcd-ef1234567890/channel-eligibility",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "users", "a1b2c3d4-e5f6-7890-abcd-ef1234567890", "channel-eligibility"]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"userId\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\",\n  \"status\": \"SUSPENDIDO\",\n  \"aptoParaVinculoCanal\": false\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "2. Errores",
      "description": "Casos reales del contrato uniforme de errores.",
      "item": [
        {
          "name": "Alta — validación (400 VALIDATION_ERROR)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 VALIDATION_ERROR', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().code).to.eql('VALIDATION_ERROR');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users"]
            },
            "description": "Body vacío: faltan campos obligatorios."
          },
          "response": [
            {
              "name": "400 - validación",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
