              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('status ACTIVE', () => pm.expect(body.status).to.eql('ACTIVE'));",
                  "pm.test('channelLinkEligible', () => pm.expect(body.channelLinkEligible).to.be.true);",
                  "pm.collectionVariables.set('userId', body.id);"
                ]
              }
            }
