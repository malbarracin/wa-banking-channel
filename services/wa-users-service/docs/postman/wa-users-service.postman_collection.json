            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SUSPENDED\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/users/{{userId}}/status",
            "description": "U4 — ACTIVE → SUSPENDED (channelLinkEligible=false)"
