        {
          "name": "GET By document (OK)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users?documentType={{documentType}}&documentNumber={{documentNumber}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users"],
              "query": [
                { "key": "documentType", "value": "{{documentType}}" },
                { "key": "documentNumber", "value": "{{documentNumber}}" }
              ]
            },
            "description": "U2 — Consulta por documento"
          },
          "response": []
        },
        {
          "name": "GET By id (404 not found)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users/000000000000000000000000",
            "description": "U2 — Id inexistente → 404 NOT_FOUND"
          },
          "response": []
        }
      ]
    },
    {
      "name": "U3 Update",
      "item": [
        {
          "name": "PATCH Update fields (OK)",
          "request": {
            "method": "PATCH",
            "header": [
