          "response": []
        },
        {
          "name": "PATCH Invalid transition (400)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SUSPENDED\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/users/{{userId}}/status",
            "description": "U4 — Misma transición inválida si ya está SUSPENDED → 400"
          },
          "response": []
        },
        {
          "name": "PATCH Reactivate (OK)",
          "request": {
            "method": "PATCH",
            "header": [
