{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bcra.local/wa/events/message-status.v1.schema.json",
  "allOf": [
    {"$ref": "envelope.v1.schema.json"},
    {"properties": {
      "eventType": {"const": "MessageStatus"},
      "eventVersion": {"const": 1},
      "payload": {
        "type": "object", "additionalProperties": false, "required": ["providerMessageId", "status"],
        "properties": {
          "providerMessageId": {"type": "string", "minLength": 1, "maxLength": 128},
          "status": {"enum": ["QUEUED", "SENT", "DELIVERED", "READ", "FAILED", "UNDELIVERED"]},
          "errorCode": {"type": "string", "minLength": 1, "maxLength": 32},
          "errorDetail": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    }}
  ]
}
