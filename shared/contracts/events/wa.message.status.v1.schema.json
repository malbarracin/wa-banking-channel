{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MessageStatus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "correlationId",
    "conversationId",
    "messageId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "MessageStatus"
    },
    "eventVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "conversationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "messageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "queued",
            "sent",
            "delivered",
            "read",
            "failed"
          ]
        },
        "errorCode": {
          "type": "string",
          "pattern": "^[A-Z0-9_-]{1,64}$"
        }
      }
    }
  }
}
