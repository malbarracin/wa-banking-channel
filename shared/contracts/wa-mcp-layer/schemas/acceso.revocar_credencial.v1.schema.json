{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "acceso.revocar_credencial.v1",
  "description": "Capacidad acceso.revocar_credencial v1; servicio H2; actor agente; handler revocar_credencial; requiere_credencial=False; habilitada=True",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entrada",
    "salida"
  ],
  "properties": {
    "entrada": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contexto",
        "parametros"
      ],
      "properties": {
        "contexto": {
          "$ref": "_envelope.json#/definitions/contexto"
        },
        "parametros": {
          "additionalProperties": false,
          "properties": {
            "motivo": {
              "enum": [
                "BLOQUEO",
                "DESVINCULACION",
                "FRAUDE",
                "POLITICA_BANCO",
                "REVOCACION_MASIVA",
                "REEMPLAZO"
              ],
              "title": "Motivo",
              "type": "string"
            },
            "solicitadoPor": {
              "default": "CANAL",
              "enum": [
                "CANAL",
                "BANCO",
                "SISTEMA"
              ],
              "title": "Solicitadopor",
              "type": "string"
            }
          },
          "required": [
            "motivo"
          ],
          "title": "Revocacion",
          "type": "object"
        }
      }
    },
    "salida": {
      "oneOf": [
        {
          "$ref": "_envelope.json#/definitions/salida_exito"
        },
        {
          "$ref": "_envelope.json#/definitions/salida_error"
        }
      ]
    }
  },
  "x-mcp": {
    "nombre": "acceso.revocar_credencial",
    "version": 1,
    "servicio": "H2",
    "actor": "agente",
    "handler": "revocar_credencial",
    "requiere_credencial": false,
    "habilitada": true,
    "tool_name": "acceso_revocar_credencial_v1"
  }
