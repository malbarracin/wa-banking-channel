{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cuentas.consultar_movimientos.v1",
  "description": "Capacidad cuentas.consultar_movimientos v1; servicio H4; actor agente; handler consultar_movimientos; requiere_credencial=True; habilitada=True",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entrada",
    "salida"
  ],
  "properties": {
    "entrada": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contexto",
        "parametros"
      ],
      "properties": {
        "contexto": {
          "$ref": "_envelope.json#/definitions/contexto"
        },
        "parametros": {
          "additionalProperties": false,
          "properties": {
            "numero": {
              "maxLength": 34,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "title": "Numero",
              "type": "string"
            },
            "desde": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Desde"
            },
            "hasta": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Hasta"
            },
            "tipo": {
              "anyOf": [
                {
                  "enum": [
                    "DEBITO",
                    "CREDITO"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Tipo"
            },
            "limit": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Limit"
            },
            "cursor": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Cursor"
            }
          },
          "required": [
            "numero"
          ],
          "title": "Movimientos",
          "type": "object"
        }
      }
    },
    "salida": {
      "oneOf": [
        {
          "$ref": "_envelope.json#/definitions/salida_exito"
        },
        {
          "$ref": "_envelope.json#/definitions/salida_error"
        }
      ]
    }
  },
  "x-mcp": {
    "nombre": "cuentas.consultar_movimientos",
    "version": 1,
    "servicio": "H4",
    "actor": "agente",
    "handler": "consultar_movimientos",
    "requiere_credencial": true,
    "habilitada": true,
    "tool_name": "cuentas_consultar_movimientos_v1"
  }
}
