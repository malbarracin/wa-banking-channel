{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "vinculo.consultar_estado.v1",
  "description": "Capacidad vinculo.consultar_estado v1; servicio H3; actor agente; handler consultar_estado; requiere_credencial=False; habilitada=True",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entrada",
    "salida"
  ],
  "properties": {
    "entrada": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contexto",
        "parametros"
      ],
      "properties": {
        "contexto": {
          "$ref": "_envelope.json#/definitions/contexto"
        },
        "parametros": {
          "additionalProperties": false,
          "properties": {
            "numero_whatsapp": {
              "anyOf": [
                {
                  "pattern": "^\\+[1-9][0-9]{6,14}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Numero Whatsapp"
            }
          },
          "title": "Numero",
          "type": "object"
        }
      }
    },
    "salida": {
      "oneOf": [
        {
          "$ref": "_envelope.json#/definitions/salida_exito"
        },
        {
          "$ref": "_envelope.json#/definitions/salida_error"
        }
      ]
    }
  },
  "x-mcp": {
    "nombre": "vinculo.consultar_estado",
    "version": 1,
    "servicio": "H3",
    "actor": "agente",
    "handler": "consultar_estado",
    "requiere_credencial": false,
    "habilitada": true,
    "tool_name": "vinculo_consultar_estado_v1"
  }
}
